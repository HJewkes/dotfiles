{{- $name := promptStringOnce . "name" "Git author name" -}}
{{- $email := promptStringOnce . "email" "Git author email" -}}
{{- $machine := promptChoiceOnce . "machine" "Machine type" (list "personal" "work" "server") -}}
{{- $awDataDir := "" -}}
{{- $macHost := "" -}}
{{- $profiles := (include ".chezmoidata/profiles.toml" | fromToml).profiles -}}
{{- $roleData := dict "profiles" $profiles "machine" $machine "extraRoles" (get . "extraRoles" | default list) "withoutRoles" (get . "withoutRoles" | default list) -}}
{{- $roles := includeTemplate "roles" $roleData | fromJson -}}
{{- if has "backup-repo-host" $roles -}}
{{-   $awDataDir = promptStringOnce . "awDataDir" "active-work data dir to back up (may use $HOME)" -}}
{{-   $macHost = promptStringOnce . "macHost" "Mac hostname whose restic snapshots to stamp" -}}
{{- end }}

encryption = "age"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1j7hqrrzez0xus82vt3akl79vwev7cyt7mzdymz2kzrvu6wqjmpkqxgsm0v"

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    machine = {{ $machine | quote }}
{{- if $awDataDir }}
    awDataDir = {{ $awDataDir | quote }}
{{- end }}
{{- if $macHost }}
    macHost = {{ $macHost | quote }}
{{- end }}

.claude/skills/*/scripts/test_*.py

# Cursor skills — installed by npx skills add, not chezmoi
.cursor/skills


# Test runs write bytecode into the source tree
.claude/skills/*/scripts/__pycache__

# Source-tree tests, never deployed
tests

{{ if ne .chezmoi.os "darwin" }}
# macOS only. LaunchAgents, and the usage refresher one of them drives.
Library
.claude/scripts/refresh-usage.sh
# The claude shim needs a PATH directory ahead of ~/.local/bin, which only
# /opt/homebrew/bin provides.
.local/libexec/claude-shim
install-claude-shim.sh
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
# Linux only; macOS gets ~/.local/bin from .zshrc and path_helper.
.zshenv
# The Mac runs the trust sync from a LaunchAgent instead (item 198).
.config/systemd/user/claude-trust-sync.service
.config/systemd/user/claude-trust-sync.timer
# Rootless Docker runs on the Linux server only (BS-30).
.config/systemd/user/docker.service
.config/environment.d/60-docker-rootless.conf
.local/bin/dockerd-rootless.sh
{{ end }}

{{ if not (has "agent-desktop" $roles) }}
# kwin-mcp (KDE computer use for agents) requires Linux and agent-desktop.
.local/share/kwin-mcp
.claude/scripts/kwin-session-start-guard.py
install-kwin-mcp.sh
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# Opens the basement console sign-in page in this Mac's browser.
.local/bin/console-login
{{ end }}

{{ if not (has "factory-host" $roles) }}
# The tmp inode alarm runs on basement only.
.local/bin/tmp-inode-alarm
.config/systemd/user/tmp-inode-alarm.service
.config/systemd/user/tmp-inode-alarm.timer
# The console TLS drop-in reads the tailnet name from tailscale on basement (TP-1998).
.config/systemd/user/titan-console.service.d
# Basement health check every 5 min (BS-6, BS-39).
.local/bin/basement-health
.config/systemd/user/basement-health.service
.config/systemd/user/basement-health.timer
# The host drift check reads the console checkout on basement (BS-29).
.local/bin/env-drift-check
.config/systemd/user/env-drift-check.service
.config/systemd/user/env-drift-check.timer
# Mints console sign-in links with the titan-console unit's environment.
.local/bin/titan-console-login-link
# Basement units: the digest timer (BS-33) and the mise node drop-ins (BS-29).
.config/systemd/user/titan-factory-digest.service
.config/systemd/user/titan-factory-digest.timer
.config/systemd/user/active-work.service.d
.config/systemd/user/agent-chat-burndown.service.d
.config/systemd/user/agent-chat-seat-watchdog-pilot.service.d
.config/systemd/user/agent-chat-seat-watchdog.service.d
.config/systemd/user/session-miner-refresh.service.d
# Basement units resolve node through mise shims (BS-35).
.config/mise
{{ end }}

{{ if not (has "backup-repo-host" $roles) }}
# Restic backups to the UNAS mount (BS-6, BS-23) and the encrypted repo password.
.config/restic
.local/bin/restic-nightly
.local/bin/restic-check
.local/bin/restic-stamp-mac
.config/systemd/user/restic-nightly.service
.config/systemd/user/restic-nightly.timer
.config/systemd/user/restic-check.service
.config/systemd/user/restic-check.timer
.config/systemd/user/restic-stamp-mac.service
.config/systemd/user/restic-stamp-mac.timer
{{ end }}
